NODE_ENV=production
DEMO_MODE=true
MYSQLHOST=localhost
MYSQLPORT=3306
MYSQLDATABASE=pokedex_demo
MYSQLUSER=pokedex_demo
MYSQLPASSWORD=REEMPLAZAR_LOCALMENTE
# No fijar IP/HOST/PORT en alojamiento; utilizar los asignados por el proveedor.
# Opcional: npm run admin:setup configura el acceso por HTTPS en el servidor.
ADMIN_ENABLED=false
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
TRUST_PROXY=false
COOKIE_SECURE=true

# Vacío en local; /pokedex en alwaysdata para convivir con BookApp.
BASE_PATH=
