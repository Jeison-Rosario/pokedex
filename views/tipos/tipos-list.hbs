<section class="py-4"><h1>Tipos</h1><p class="text-muted">Tipos disponibles en la Pokédex.</p>{{#if canManage}}<a href="{{@root.basePath}}/create-tipos" class="btn btn-primary mb-3">Agregar tipo</a>{{/if}}</section>
<div class="info-grid">
{{#each tipos as |item|}}
<article class="card h-100"><div class="card-body"><h2 class="h5">{{item.tipo}}</h2>
{{#if @root.canManage}}<div class="d-flex flex-wrap gap-2 mt-3"><a href="{{@root.basePath}}/edit-tipos/{{item.idTipo}}?edit=true" class="btn btn-outline-primary">Editar</a><form action="{{@root.basePath}}/delete-tipos" method="post"><input type="hidden" name="_csrf" value="{{@root.csrfToken}}"><input type="hidden" name="tipoId" value="{{item.idTipo}}"><button type="submit" class="btn btn-outline-danger">Eliminar</button></form></div>{{/if}}
</div></article>
{{else}}<p class="grid-message">No hay registros disponibles.</p>{{/each}}
</div>
