<section class="row justify-content-center py-4"><div class="col-12 col-md-7 col-lg-6">
<h1 class="h3">{{#if editMode}}Editar{{else}}Agregar{{/if}} Pokémon</h1>
{{#if hasRegiones}}{{#if hasTipos}}
<form method="post" enctype="multipart/form-data" action="{{#if editMode}}{{@root.basePath}}/edit-pokemones{{else}}{{@root.basePath}}/create-pokemones{{/if}}">
  <input type="hidden" name="_csrf" value="{{csrfToken}}">
  <div class="mb-3"><label for="image" class="form-label">Imagen PNG o JPEG, hasta 2 MB</label><input type="file" class="form-control" id="image" name="pokemonImage" accept="image/png,image/jpeg"></div>
  {{#if editMode}}<img src="{{url pokemon.imagePokemon}}" alt="Imagen actual de {{pokemon.namePokemon}}" class="pokemon-image mb-3"><input type="hidden" name="pokemonId" value="{{pokemon.idPokemon}}">{{/if}}
  <div class="mb-3"><label for="name" class="form-label">Nombre</label><input class="form-control" id="name" name="pokemonName" maxlength="50" required value="{{#if editMode}}{{pokemon.namePokemon}}{{/if}}"></div>
  <div class="mb-3"><label for="region" class="form-label">Región</label><select class="form-select" id="region" name="regionPokemonId" required><option value="">Selecciona una región</option>{{#each regiones}}<option value="{{idRegion}}" {{#if (equalValue idRegion ../pokemon.regionPokemonId)}}selected{{/if}}>{{region}}</option>{{/each}}</select></div>
  <div class="mb-3"><label for="tipo" class="form-label">Tipo</label><select class="form-select" id="tipo" name="tipoPokemonId" required><option value="">Selecciona un tipo</option>{{#each tipos}}<option value="{{idTipo}}" {{#if (equalValue idTipo ../pokemon.tipoPokemonId)}}selected{{/if}}>{{tipo}}</option>{{/each}}</select></div>
  <button class="btn btn-primary" type="submit">Guardar</button> <a class="btn btn-outline-secondary" href="{{@root.basePath}}/pokemones-list">Volver</a>
</form>
{{else}}<p>Agrega al menos un tipo antes de crear Pokémon.</p><a href="{{@root.basePath}}/create-tipos">Agregar tipo</a>{{/if}}
{{else}}<p>Agrega al menos una región y un tipo antes de crear Pokémon.</p><a href="{{@root.basePath}}/create-regiones">Agregar región</a>{{/if}}
</div></section>
