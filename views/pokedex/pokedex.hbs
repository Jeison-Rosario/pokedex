<section class="catalog-heading py-4">
  <p class="text-uppercase small fw-bold text-danger mb-2">Explora el catálogo</p>
  <h1>Pokédex</h1>
  <p class="lead text-muted">Busca tus Pokémon y descubre su tipo y región.</p>
  {{#if canManage}}<div class="d-flex flex-wrap gap-2 mb-3"><a href="{{@root.basePath}}/create-pokemones" class="btn btn-primary">Agregar Pokémon</a><a href="{{@root.basePath}}/create-regiones" class="btn btn-outline-secondary">Agregar región</a><a href="{{@root.basePath}}/create-tipos" class="btn btn-outline-secondary">Agregar tipo</a></div>{{/if}}
  <form method="get" action="{{@root.basePath}}/" class="catalog-filters">
    <div><label for="search" class="form-label">Nombre</label><input id="search" name="search" class="form-control" value="{{search}}" placeholder="Por ejemplo, Pikachu" maxlength="80"></div>
    <div><label for="filter-region" class="form-label">Región</label><select id="filter-region" name="region" class="form-select"><option value="">Todas las regiones</option>{{#each regiones}}<option value="{{idRegion}}" {{#if selected}}selected{{/if}}>{{region}}</option>{{/each}}</select></div>
    <div><label for="filter-type" class="form-label">Tipo</label><select id="filter-type" name="tipo" class="form-select"><option value="">Todos los tipos</option>{{#each tipos}}<option value="{{idTipo}}" {{#if selected}}selected{{/if}}>{{tipo}}</option>{{/each}}</select></div>
    <div class="d-flex gap-2 align-items-end"><button type="submit" class="btn btn-primary">Buscar</button><a href="{{@root.basePath}}/" class="btn btn-outline-secondary">Limpiar</a></div>
  </form>
</section>
<p class="text-muted">Resultados: {{total}}</p>
{{> pokemon-cards}}
<nav class="d-flex flex-wrap gap-3 align-items-center justify-content-center my-4" aria-label="Páginas del catálogo">
  {{#if previousUrl}}<a class="btn btn-outline-secondary" href="{{url previousUrl}}">Anterior</a>{{/if}}
  <span>Página {{page}} de {{pages}}</span>
  {{#if nextUrl}}<a class="btn btn-outline-secondary" href="{{url nextUrl}}">Siguiente</a>{{/if}}
</nav>
