<section class="row justify-content-center py-4"><div class="col-12 col-md-7 col-lg-6">
<h1 class="h3">{{#if editMode}}Editar{{else}}Agregar{{/if}} region</h1>
<form method="post" action="{{#if editMode}}{{@root.basePath}}/edit-regiones{{else}}{{@root.basePath}}/create-regiones{{/if}}">
<input type="hidden" name="_csrf" value="{{csrfToken}}">
<label for="name" class="form-label">Nombre</label><input class="form-control mb-3" id="name" name="Name" maxlength="50" required value="{{#if editMode}}{{region.region}}{{/if}}">
{{#if editMode}}<input type="hidden" name="regionId" value="{{region.idRegion}}">{{/if}}
<button class="btn btn-primary" type="submit">Guardar</button> <a class="btn btn-outline-secondary" href="{{@root.basePath}}/regiones-list">Volver</a>
</form></div></section>
